# Vacío en desarrollo: Vite hace proxy de /api a http://localhost:8000.
# En producción: URL pública de la API, sin /api al final. Ej. https://api.operativai.com.mx
VITE_API_URL=
# Conectar Facebook en Canales: id de la app de Meta (el mismo META_APP_ID del backend) y,
# opcionalmente, el config_id de "Facebook Login for Business". Sin app id el botón avisa que falta configurar.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
